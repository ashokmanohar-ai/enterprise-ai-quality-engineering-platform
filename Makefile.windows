# PowerShell equivalents (invoke with: nmake /f Makefile.windows <target>)
PYTHON=python

setup:
	$(PYTHON) -m venv .venv
	.venv\Scripts\python -m pip install -e ".[dev,llm,rag,mcp]"
	npm ci

test-pr:
	.venv\Scripts\python -m pytest tests\unit
	.venv\Scripts\python scripts\mark_suite.py deterministic
	.venv\Scripts\python -m pytest tests\agents
	.venv\Scripts\python scripts\mark_suite.py agent
	.venv\Scripts\python -m pytest tests\mcp
	.venv\Scripts\python scripts\mark_suite.py mcp
	.venv\Scripts\python -m ai_quality.cli run --profile pr --suite llm
	.venv\Scripts\python -m ai_quality.cli run --profile pr --suite rag
	.venv\Scripts\python -m ai_quality.cli run --profile pr --suite prompt_regression
	.venv\Scripts\python -m pytest tests\regression
	.venv\Scripts\python scripts\mark_suite.py security_smoke
	.venv\Scripts\python -m ai_quality.cli gate --profile pr

quality-gate:
	.venv\Scripts\python -m ai_quality.cli gate --profile pr
