# Azure OpenAI - never commit real values
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=
AZURE_OPENAI_EVALUATOR_DEPLOYMENT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=
AZURE_OPENAI_MODEL_A_DEPLOYMENT=
AZURE_OPENAI_MODEL_B_DEPLOYMENT=

# Select exactly one production trace destination: none | phoenix | langfuse
OBSERVABILITY_BACKEND=none
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# Safety, cost, and execution controls
AIQ_PROFILE=dev
AIQ_MAX_EVALUATION_CASES=10
AIQ_MAX_CONCURRENCY=2
AIQ_EVALUATION_BUDGET_USD=5.00
AIQ_ALLOW_LIVE_MODEL_CALLS=false
AIQ_SECURITY_AUTHORIZED=false
AIQ_PERFORMANCE_AUTHORIZED=false
AIQ_RANDOM_SEED=42
AIQ_TRACE_CONTENT=false
